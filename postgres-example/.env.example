POSTGRES_USER=example_user
# This is deliberately malformed so you pick a different password.
POSTGRES_PASSWORD=<example_password>
POSTGRES_DB=default_example_db
# The database URL would then look like this
POSTGRES_URL=postgresql://example_user:<example_password>@postgres:5432/default_example_db
# We don't set up the container with 5432 open by default, but you can add the port if you want to use this URL outside the container for some reason.
# See connect-to-db.sh if you just want to psql inside the container.
